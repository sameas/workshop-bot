# токен от @BotFather
BOT_TOKEN=

# telegram id админов через запятую (свой id: /start боту)
ADMIN_IDS=

# чат мастеров для анонсов и напоминаний, id взять через /id в самом чате (у супергруппы с -100)
# если пусто, в чат ничего не постится
MASTERS_CHAT_ID=

# id календаря google; если пусто, календарь выключен
# ключ сервис-аккаунта: secrets/google-sa.json
GCAL_CALENDAR_ID=

TZ=Asia/Novosibirsk

# пауза между мастер-классами, минут
BUFFER_MINUTES=30
# шаг сетки начала в минутах, делитель 1440 от 15 до 240 (15, 20, 30, 60...)
SLOT_STEP_MINUTES=30
# кнопки длительности, минут (15-1440)
#DURATIONS_MINUTES=60,90,120,180,240,300,360,480,540,600,720
# на сколько дней вперёд показывать даты
DAYS_AHEAD=21
# за сколько минут до начала напоминать; пустое значение отключает напоминания
REMIND_BEFORE_MINUTES=1440,60

LOG_LEVEL=INFO

# образ из реестра вместо локальной сборки (на сервере)
#BOT_IMAGE=ghcr.io/owner/workshop-bot:latest
